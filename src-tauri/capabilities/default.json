{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability",
  "windows": [
    "main",
    "message-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-badge-count",
    "dialog:default",
    "autostart:default",
    "notification:default",
    "core:webview:allow-create-webview-window",
    "core:event:default",
    "deep-link:default",
    "opener:default"
  ]
}
